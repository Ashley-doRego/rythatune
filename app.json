{
  "expo": {
    "name": "Metronome",
    "slug": "metronome",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "metronome",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "android": {
      "backgroundColor": "#000000",
      "package": "com.garado.metronome",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withAndroidConfigChanges",
      "./plugins/withAndroidTheme"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        
      }
    },
    "owner": "agarado",
    "ios": {
      "bundleIdentifier": "com.garado.metronome"
    }
  }
}
